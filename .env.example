# Copy to .env and fill in values from the Supabase project settings.

# Frontend (safe to expose; protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_URL=http://localhost:5173

# Backend (never put these in the Vite client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
OPENAI_API_KEY=
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_SOL=gpt-5.6-sol
API_PORT=8787
APP_URL=http://localhost:5173

# Licensed aggregators for LinkedIn / Indeed / Glassdoor listings (optional)
# Create a RapidAPI account, subscribe to JSearch, then paste the key.
RAPIDAPI_KEY=

# Optional extra job index: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional official US federal jobs: use the email USAJOBS asks for in User-Agent
USAJOBS_EMAIL=

# Billing — Stripe Checkout (cards, Apple Pay, Google Pay) and PayPal subscriptions
# Leave empty to use demo checkout (activates the plan locally without charging).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
