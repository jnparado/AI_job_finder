# Copy to .env and fill in values from the Supabase project settings.

# Frontend (safe to expose; protected by RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_APP_URL=http://localhost:5173

# Backend (never put these in the Vite client)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
OPENAI_API_KEY=
OPENAI_MODEL_LUNA=gpt-5.6-luna
OPENAI_MODEL_TERRA=gpt-5.6-terra
OPENAI_MODEL_SOL=gpt-5.6-sol
API_PORT=8787
APP_URL=http://localhost:5173

# RapidAPI key — used for both JSearch (Google for Jobs) and Jobs API (Bing / Indeed / LinkedIn).
# Subscribe: https://rapidapi.com/letscrape-6bRWa3QguO5/api/jsearch
#            https://rapidapi.com/Pat92/api/jobs-api14
RAPIDAPI_KEY=

# Optional extra job index: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional official US federal jobs: use the email USAJOBS asks for in User-Agent
USAJOBS_EMAIL=

# Billing — Stripe Checkout (cards, Apple Pay, Google Pay) and PayPal subscriptions
# Leave empty to use demo checkout (activates the plan locally without charging).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Auth — Email is required. Candidates and employers both sign in through Supabase Auth.
# Dashboard → Authentication → Providers → Email: enable.
# Site URL = your live app. Redirect URLs must include /auth/callback
# Optional social: enable each provider below.
VITE_META_PIXEL_ID=
VITE_META_APP_ID=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_THREADS=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_X=
VITE_SOCIAL_TIKTOK=
VITE_SOCIAL_YOUTUBE=
VITE_SOCIAL_WHATSAPP=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_PINTEREST=

# Google — OAuth consent + client go in Supabase Auth → Google.
# These IDs are for Analytics, Tag Manager, and Search Console on the site.
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_TAG_MANAGER_ID=
VITE_GOOGLE_SITE_VERIFICATION=
